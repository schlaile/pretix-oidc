msgstr ""
"Verbinden Sie Ihr Konto für Single Sign-on über OpenID Connect."

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_delete.html:5
msgid "Delete team assignment rule:"
msgstr "Team-Zuweisungsregel löschen:"

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_delete.html:8
msgid "Are you sure you want to delete this rule?"
msgstr "Möchten Sie diese Regel wirklich löschen?"

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_delete.html:12
msgid "Cancel"
msgstr "Abbrechen"

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_delete.html:15
#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rules.html:61
msgid "Delete"
msgstr "Löschen"

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_edit.html:6
msgid "Modify team assignment rule"
msgstr "Team-Zuweisungsregel bearbeiten"

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_edit.html:8
#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rules.html:23
msgid "Create team assignment rule"
msgstr "Team-Zuweisungsregel erstellen"

#: pretix_oidc/templates/pretix_oidc/oidc_assignment_rule_edit.html:20

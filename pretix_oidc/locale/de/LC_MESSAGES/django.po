msgstr "(keine E-Mail)"

#: forms.py:36
msgid "OpenID Connect account"
msgstr "OpenID-Connect-Konto"

#: forms.py:38
msgid "Select the OpenID Connect account to merge into this native account."
msgstr ""
"Wählen Sie das OpenID-Connect-Konto aus, das in dieses native Konto "
"zusammengeführt werden soll."

#: forms.py:40
msgid "Select an account…"
msgstr "Konto auswählen…"

#: forms.py:61
msgid "Please enter the same password twice"
msgstr ""

#: forms.py:66
msgid "New password"
msgstr "Neues Passwort"

#: forms.py:71
msgid "Repeat new password"
msgstr "Neues Passwort wiederholen"

#: forms.py:76
msgid "Force password change on next login"
msgstr "Passwortänderung bei der nächsten Anmeldung erzwingen"

#: forms.py:78
msgid "The user must choose a new password the next time they sign in."
msgstr ""
"Der Benutzer muss bei der nächsten Anmeldung ein neues Passwort wählen."

#: linking.py:52 linking.py:59
msgid ""
"The email address from OpenID Connect is not verified. Please confirm your "
"email address with your identity provider first."
msgstr ""
"Die E-Mail-Adresse von OpenID Connect ist nicht verifiziert. Bitte "
"bestätigen Sie zuerst Ihre E-Mail-Adresse bei Ihrem Identitätsanbieter."

#: linking.py:143 views.py:257 views.py:310 views.py:375
msgid "Account linking is disabled."
msgstr "Kontoverknüpfung ist deaktiviert."

#: linking.py:145
msgid "Only native accounts can be linked."
msgstr "Nur native Konten können verknüpft werden."

#: linking.py:147
msgid "Email addresses do not match."
msgstr "Die E-Mail-Adressen stimmen nicht überein."

#: linking.py:156
msgid "This OpenID identity is already linked to another account."
msgstr "Diese OpenID-Identität ist bereits mit einem anderen Konto verknüpft."

#: merge.py:72
msgid "Cannot merge a user with itself."
msgstr "Ein Benutzer kann nicht mit sich selbst zusammengeführt werden."

#: merge.py:74 views.py:481
msgid "The target account must use the native login backend."
msgstr "Das Zielkonto muss das native Anmelde-Backend verwenden."

#: merge.py:76 views.py:533
msgid "The source account must use OpenID Connect."
msgstr "Das Quellkonto muss OpenID Connect verwenden."

#: merge.py:78 merge.py:131 views.py:535
msgid "The OpenID Connect account has no external identifier."
msgstr "Das OpenID-Connect-Konto hat keinen externen Identifikator."

#: merge.py:80
msgid "The OpenID Connect account has no email address."
msgstr "Das OpenID-Connect-Konto hat keine E-Mail-Adresse."

#: merge.py:93
msgid "Another account already uses the OpenID Connect email address."
msgstr "Ein anderes Konto verwendet bereits die OpenID-Connect-E-Mail-Adresse."

#: merge.py:129
#, fuzzy
#| msgid "The source account must use OpenID Connect."
msgid "The account must use OpenID Connect."
